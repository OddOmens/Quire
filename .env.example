# Run a released image instead of the latest one (docker compose pull).
# QUIRE_VERSION=0.1.0
# Where your pages live on the host (plain Markdown files, one folder per space).
QUIRE_NOTES_DIR=./notes
# Account, devices, page history and share links. Back this up too.
QUIRE_DATA_DIR=./data
QUIRE_PORT=8196
# Only this machine can reach Quire by default: use Tailscale Serve or a reverse
# proxy here. Set your LAN or Tailscale address (or 0.0.0.0 for every network)
# to open it to other devices directly.
QUIRE_BIND=127.0.0.1
# Proxies allowed to tell Quire the real client address (X-Forwarded-For), for
# sign-in rate limits and the devices list. Loopback is always trusted. With a
# proxy on the host talking to the container (Tailscale Serve, Caddy, nginx),
# add the exact address it arrives from, the gateway of Quire's network
# (`docker network inspect quire_default`), not a whole range: every container
# in a range could claim any address. Left empty behind a proxy, every visitor
# shares one sign-in limit, so a few wrong passwords lock everyone out.
# QUIRE_TRUSTED_PROXIES=172.18.0.1/32
QUIRE_TRUSTED_PROXIES=
# A second address inside the container that serves only public forms
# (/f/<token>), for a tunnel or reverse proxy to reach without reaching
# Quire. Off unless set; also uncomment the port in docker-compose.yml.
# QUIRE_PUBLIC_LISTEN=:8081
# Days deleted pages stay in the trash.
QUIRE_TRASH_DAYS=30
PUID=1000
PGID=1000
